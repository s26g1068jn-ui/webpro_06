<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>おすすめの本</title>
</head>
<body>
  <h2>おすすめの本の一覧</h2>
  <table border="1">
    <tr><th>ID</th><th>タイトル</th><th>著者</th><th>出版年</th></tr>
    <% for( let row of data ) { %>
      <tr>
        <td><%= row.id %></td>
        <td><%= row.title %></td>
        <td><%= row.author %></td>
        <td><%= row.year %></td>
      </tr>
    <% } %>
  </table>
  <p><a href="/public/book_add.html">本を追加する</a></p>
</body>
</html>
